{
  "name": "arun-design-system",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean",
    "clean:all": "turbo run clean && rm -rf .turbo node_modules packages/*/node_modules",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:browser": "turbo run test:browser",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build && changeset publish",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.0",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@commitlint/types": "21.2.3",
    "eslint": "10.12.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.9",
    "turbo": "2.11.7",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.32.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "peerDependencyRules": {
      "allowedVersions": {
        "eslint-plugin-jsx-a11y>eslint": "10",
        "eslint-plugin-react>eslint": "10"
      }
    },
    "overrides": {
      "brace-expansion@1": "1.1.21",
      "brace-expansion@2": "2.1.4",
      "brace-expansion@5": "5.0.12",
      "dompurify@3": "3.4.16",
      "fast-uri@3": "3.1.8",
      "js-yaml@3": "3.15.2",
      "js-yaml@4": "4.3.2",
      "nanoid@3": "3.3.18",
      "postcss@8": "8.5.26",
      "undici@8": "8.10.2",
      "esbuild@0.27": "0.28.1",
      "devalue@5": "5.9.3",
      "katex@0": "0.18.2",
      "postcss-selector-parser@6": "7.1.6",
      "sharp@0": "0.35.5",
      "smol-toml@1": "1.9.0",
      "source-map-js@1": "1.2.2"
    }
  }
}
