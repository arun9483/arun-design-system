{
  "name": "@arun-dev/headless",
  "version": "0.3.0",
  "description": "Unstyled React behaviour primitives — render engine, controlled/uncontrolled state, and data-* state projection. Ships no CSS and no class names.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arun9483/arun-design-system.git",
    "directory": "packages/headless"
  },
  "keywords": [
    "react",
    "headless",
    "unstyled",
    "design-system",
    "primitives"
  ],
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./switch": {
      "import": {
        "types": "./dist/switch/index.d.ts",
        "default": "./dist/switch/index.js"
      },
      "require": {
        "types": "./dist/switch/index.d.cts",
        "default": "./dist/switch/index.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist .turbo",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "pnpm run test:unit",
    "test:unit": "vitest run --passWithNoTests --config vitest.unit.config.ts"
  },
  "peerDependencies": {
    "@types/react": ">=19.0.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arun-dev/config": "workspace:*",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "9.39.4",
    "jsdom": "27.0.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "3.2.6"
  }
}
