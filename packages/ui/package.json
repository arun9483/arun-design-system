{
  "name": "@arun-dev/ui",
  "version": "5.5.0",
  "description": "Brand-agnostic React component library styled entirely via @arun-dev/tokens semantic CSS custom properties",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arun9483/arun-design-system.git",
    "directory": "packages/ui"
  },
  "keywords": [
    "react",
    "components",
    "design-system",
    "css-custom-properties"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./components.css": "./dist/css/components.css",
    "./css/reset": "./dist/css/reset.css",
    "./css/btn": "./dist/css/btn.css",
    "./css/card": "./dist/css/card.css",
    "./css/chip": "./dist/css/chip.css",
    "./css/badge": "./dist/css/badge.css",
    "./css/metric": "./dist/css/metric.css",
    "./css/utilities": "./dist/css/utilities.css",
    "./css/input": "./dist/css/input.css",
    "./css/textarea": "./dist/css/textarea.css",
    "./css/select": "./dist/css/select.css",
    "./css/dialog": "./dist/css/dialog.css",
    "./css/popover": "./dist/css/popover.css",
    "./css/menu": "./dist/css/menu.css",
    "./css/combobox": "./dist/css/combobox.css",
    "./css/tooltip": "./dist/css/tooltip.css",
    "./css/tabs": "./dist/css/tabs.css",
    "./css/checkbox": "./dist/css/checkbox.css",
    "./css/radio-group": "./dist/css/radio-group.css",
    "./css/switch": "./dist/css/switch.css",
    "./css/field": "./dist/css/field.css",
    "./css/link": "./dist/css/link.css",
    "./css/separator": "./dist/css/separator.css",
    "./css/progress": "./dist/css/progress.css",
    "./css/meter": "./dist/css/meter.css",
    "./css/slider": "./dist/css/slider.css",
    "./css/accordion": "./dist/css/accordion.css",
    "./css/alert": "./dist/css/alert.css",
    "./css/spinner": "./dist/css/spinner.css",
    "./css/skeleton": "./dist/css/skeleton.css",
    "./css/toast": "./dist/css/toast.css",
    "./css/breadcrumb": "./dist/css/breadcrumb.css",
    "./css/pagination": "./dist/css/pagination.css",
    "./css/table": "./dist/css/table.css",
    "./css/kbd": "./dist/css/kbd.css",
    "./css/toggle": "./dist/css/toggle.css",
    "./css/toolbar": "./dist/css/toolbar.css",
    "./css/avatar": "./dist/css/avatar.css",
    "./css/otp-input": "./dist/css/otp-input.css",
    "./css/stack": "./dist/css/stack.css",
    "./css/grid": "./dist/css/grid.css",
    "./css/heading": "./dist/css/heading.css",
    "./css/paragraph": "./dist/css/paragraph.css",
    "./css/drawer": "./dist/css/drawer.css",
    "./css/hover-card": "./dist/css/hover-card.css",
    "./css/stepper": "./dist/css/stepper.css",
    "./css/tree-view": "./dist/css/tree-view.css",
    "./css/calendar": "./dist/css/calendar.css",
    "./css/date-picker": "./dist/css/date-picker.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist .turbo",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "pnpm run test:unit",
    "test:unit": "vitest run --passWithNoTests --config vitest.unit.config.ts"
  },
  "dependencies": {
    "@arun-dev/tokens": "workspace:*"
  },
  "devDependencies": {
    "@arun-dev/config": "workspace:*",
    "@arun-dev/headless": "workspace:*",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "9.39.4",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "7.88.0",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "@arun-dev/headless": ">=4.23.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  }
}
