---
/**
 * Overrides Starlight's ThemeSelect slot so the brand switcher sits beside the
 * theme toggle. Starlight's own theme control is rendered unchanged — it already
 * sets data-theme on <html>, which is what @arun-dev/tokens reads.
 */
import Default from '@astrojs/starlight/components/ThemeSelect.astro';
import { BrandSelect } from './BrandSelect';
---

<div class="ds-brand">
  <BrandSelect client:load />
  <Default {...Astro.props}><slot /></Default>
</div>
