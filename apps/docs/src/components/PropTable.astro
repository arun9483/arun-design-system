---
import { Table } from '@arun-dev/ui';
import { COMMON, PROPS, type PropDoc } from '../data/props';

interface Props {
  component: keyof typeof PROPS;
  /** Append the shared rows. Off for a part that renders no element, like Dialog.Root. */
  common?: boolean;
}

const { component, common = true } = Astro.props;
// PROPS is `as const` so props.assert.ts can check the names; that makes the index
// signature literal, hence the widening here.
const own = PROPS[component] as readonly PropDoc[] | undefined;

if (!own) throw new Error(`<PropTable component="${component}"> — no prop data`);

/**
 * Descriptions are prose with `backtick` spans. Escape first — several of them name
 * HTML elements like `<a>`, which would otherwise be injected as live markup.
 */
function format(description: string): string {
  const escaped = description
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;');

  return escaped.replace(/`([^`]+)`/g, '<code>$1</code>');
}

// A component may document a shared prop itself when it behaves differently there —
// Input's className goes on its box — and its own row replaces the shared one.
const rows: readonly PropDoc[] = [
  ...own,
  ...(common ? COMMON.filter((shared) => !own.some((prop) => prop.name === shared.name)) : []),
];
---

<!-- The design system's Table, inside a wrapper that is the scroll box, so the wrapper is the Tab
     stop and the named region: a wide table can then be scrolled from the keyboard. -->
<div class="ds-props not-content" tabindex="0" role="region" aria-label={`${component} props`}>
  <Table.Root containerClassName="ds-props-table">
    <Table.Caption className="sr-only">{component} props</Table.Caption>
    <Table.Header>
      <Table.Row>
        <Table.Head scope="col">Prop</Table.Head>
        <Table.Head scope="col">Type</Table.Head>
        <Table.Head scope="col">Default</Table.Head>
        <Table.Head scope="col">Description</Table.Head>
      </Table.Row>
    </Table.Header>
    <Table.Body>
      {
        rows.map((prop) => (
          <Table.Row>
            <Table.Cell><code>{prop.name}</code></Table.Cell>
            <Table.Cell><code>{prop.type}</code></Table.Cell>
            <Table.Cell>
              {prop.default ? <code>{prop.default}</code> : <span aria-hidden="true">—</span>}
            </Table.Cell>
            <Table.Cell dangerouslySetInnerHTML={{ __html: format(prop.description) }} />
          </Table.Row>
        ))
      }
    </Table.Body>
  </Table.Root>
</div>
